{
  "name": "@UNscientific-9/dsh-turnfold",
  "description": "Enhancement layer for the built-in DSH 0.1.2 turn-process fold bar: duration + thinking-segment injection, expand-decision persistence, completed-only whitelist, and auto-load-older.",
  "version": "0.3.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "~18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "docs/manual-verification.md",
    "docs/assets/foldbar-demo.png",
    "README.md"
  ],
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"test/*.test.ts\""
  },
  "license": "MIT"
}
