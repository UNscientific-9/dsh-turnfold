{
  "name": "@UNscientific-9/dsh-turnfold",
  "description": "Codex/ZCode-style turn activity fold for DSH Web: streaming thinking/tools stay visible while the agent works, then fold into a permanent one-line summary above the final answer when the turn completes.",
  "version": "0.2.8",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "~18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"test/*.test.ts\""
  },
  "license": "MIT"
}
